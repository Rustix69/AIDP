// AIDP auth schema.
//
// These four models are Better Auth's core tables. The field names are not
// arbitrary — Better Auth addresses them directly through the Prisma adapter,
// so they must match `getAuthTables()` in @better-auth/core exactly. The
// `@@map` on each model pins the physical table to the singular, lowercase
// name Better Auth expects while leaving the Prisma model PascalCase.
//
// Adding a field here is only half the job: anything the sign-up form sends
// also has to be declared in `user.additionalFields` in src/lib/auth-options.ts,
// or Better Auth will reject it as an unknown field before it reaches Postgres.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 reads the connection string from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Operator of the platform, not a customer — see src/lib/access/platform.ts.
  ///
  /// A column rather than a check against an environment variable, because the
  /// admin console has to *list* administrators and an env var cannot be
  /// joined. `PLATFORM_ADMIN_EMAILS` still exists, but only to promote a
  /// matching account on sign-in: it bootstraps the first administrator on a
  /// fresh database and is never consulted afterwards.
  ///
  /// This grants sight of every organisation's people and spend. It grants no
  /// sight of their documents — see the note on the admin queries.
  isPlatformAdmin Boolean @default(false)

  // Collected at sign-up. Required in the app, so required here — see
  // `additionalFields` in src/lib/auth-options.ts for the matching declaration.
  company String
  country String
  phone   String

  sessions Session[]
  accounts Account[]

  // Which customer organisations this person can see. Consultants span several.
  memberships Membership[]

  // Standing decisions this person has ruled on.
  clauseDrafts ClauseDraft[]
  decisions    Decision[]

  // Submissions this person has approved, sent back, or escalated.
  outcomes SubmissionOutcome[]

  // Their place on a customer's roster. A consultant working for two customers
  // appears on two, which is why this is a list and not a single row.
  rosterEntries RosterEntry[]

  // Documents they put into the system. Drives cost attribution: the model
  // spend of a run lands on whoever submitted the work.
  uploads Document[]

  // Model spend attributed to them.
  usage TokenUsage[]

  // Pieces of work they opened. Attribution only — a project belongs to the
  // organisation, and outlives whoever started it.
  projects Project[]

  // Model keys they set for their organisation. Attribution only: the key
  // belongs to the company, and keeps working after the administrator who
  // pasted it has left.
  providerCredentials ProviderCredential[]

  // Architecture requests they raised, and reviews routed to them.
  // Attribution only, in both directions — see ArchitectureRequest.
  architectureRequests ArchitectureRequest[]
  reviewAssignments    ReviewAssignment[]

  // Corrections they made to findings. Attribution only: the history belongs to
  // the finding and outlives the account that wrote it.
  findingEdits FindingEdit[]

  // Standards they signed off, and standards they put into the library. Two
  // relations because they are two acts — see ClauseDraft.
  approvedClauseDrafts  ClauseDraft[] @relation("ClauseDraftApprover")
  publishedClauseDrafts ClauseDraft[] @relation("ClauseDraftPublisher")

  // Every technology status they changed. Append-only — see TechnologyChange.
  technologyChanges   TechnologyChange[]
  clauseStatusChanges ClauseStatusChange[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // For email/password this holds the hash. Better Auth marks it
  // `returned: false`, so it never leaves the server in an API response.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// Backs email verification and the password-reset flow.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organisation {
  id   String @id @default(cuid())
  name String
  // URL-safe handle. Stable once issued — it appears in paths.
  slug String @unique

  /// Company details, shown and edited on /dashboard/profile.
  ///
  /// Held on the organisation rather than on whoever registered it. The person
  /// who signed up may leave, and the company's own contact details should not
  /// leave with them — the same reason the technology reference was moved off
  /// the user before it was retired.
  ///
  /// All optional: an organisation is created the moment somebody registers,
  /// long before anyone has filled any of this in, and a required field would
  /// mean inventing a value nobody chose.
  primaryContact String @default("")
  contactEmail   String @default("")
  contactPhone   String @default("")
  country        String @default("")
  industry       String @default("")
  notes          String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  documents            Document[]
  chunks               Chunk[]
  jobs                 Job[]
  frameworks           Framework[]
  runs                 AssessmentRun[]
  clauseDrafts         ClauseDraft[]
  clauseStatusChanges  ClauseStatusChange[]
  technologies         Technology[]
  decisions            Decision[]
  outcomes             SubmissionOutcome[]
  roster               RosterEntry[]
  projects             Project[]
  usage                TokenUsage[]
  aiCache              AiCache[]
  requests             ArchitectureRequest[]
  intakeReadings       IntakeReading[]
  notifications        Notification[]
  /// This customer's own significance criteria. Seeded from the default nine
  /// and editable thereafter — see SignificanceCriterion.
  significanceCriteria SignificanceCriterion[]

  /// The company's own model key, when they have brought one. Absent is the
  /// normal state and means the deployment's own key does their work.
  credential ProviderCredential?

  @@map("organisation")
}

model Membership {
  id String @id @default(cuid())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// "owner"  — the customer's own administrator. Registered the organisation,
  ///            controls who else gets in, sees the spend. There is always at
  ///            least one, and the last one cannot be removed.
  /// "member" — an employee the owner admitted. Works in the product.
  ///
  /// "consultant" and "viewer" predate this and are treated as "member"
  /// everywhere; see ROLES in src/lib/access/roles.ts, which is the only place
  /// that decides what a role may do.
  role String @default("member")

  createdAt DateTime @default(now())

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@map("membership")
}

/// Who a customer has admitted to their organisation.
///
/// Membership says a person *has* access. This says whether they are *supposed
/// to* — and it is the row the owner actually manages. The two are deliberately
/// separate, because the useful states here exist before an account does: an
/// owner uploads a staff spreadsheet, gets two hundred people they have never
/// granted anything to, and picks a dozen. Those rows have no `userId` and must
/// not confer access; making them memberships would have admitted the entire
/// payroll the moment the file was parsed.
///
/// So this is the authority on admission and `Membership` is its consequence.
/// `status` moves imported -> allowed -> active, or sideways to revoked, and
/// `syncMembership` in src/lib/access/roster.ts is the single place that turns
/// a status into a membership. Revoking deletes the membership and the person's
/// sessions; the row stays, because "was admitted in March, revoked in June" is
/// the question an audit asks and a deleted row cannot answer it.
model RosterEntry {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Lower-cased on every write. This is the identity — an employee is a
  /// mailbox until they register, and matching has to survive "A.Patel@" versus
  /// "a.patel@" arriving from two different spreadsheets.
  email String

  /// From the spreadsheet, and only ever a label. Once the person registers,
  /// their account name is what the UI shows: they are the authority on their
  /// own name, not whatever HR typed.
  name       String @default("")
  jobTitle   String @default("")
  department String @default("")

  /// "imported" — loaded from a file or typed in. No access whatsoever.
  /// "allowed"  — admitted, but has not signed in yet. May register.
  /// "active"   — admitted and holding an account.
  /// "revoked"  — admission withdrawn. Kept for the record, never deleted.
  status String @default("imported")

  /// The membership role to grant on admission. See Membership.role.
  role String @default("member")

  /// "manual" | "import" | "signup" — how the row came to exist. An owner
  /// looking at a list of two hundred names needs to know which they typed.
  source String @default("manual")

  /// Set once the person registers, which is also what makes them "active".
  /// Null for everyone who has been admitted but has not signed up yet.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Attribution for the two decisions that matter, denormalised beside the ids
  /// for the same reason as Decision.decidedByName: the record has to keep
  /// naming the person after their account is gone.
  allowedAt     DateTime?
  allowedById   String?
  allowedByName String    @default("")
  revokedAt     DateTime?
  revokedById   String?
  revokedByName String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per mailbox per organisation. Re-importing the same spreadsheet
  /// updates the rows it already created instead of duplicating them, which is
  /// what makes a second upload safe.
  @@unique([organisationId, email])
  @@index([organisationId, status])
  @@map("roster_entry")
}

/// Model spend, one row per provider call.
///
/// Written by the workers (Workers/aidp/usage.py) and by the app, against the
/// same table, because the two both call models and an owner asking "what has
/// this cost us?" does not care which process made the request.
///
/// Attributed to a person through `userId`, which is copied from
/// `Document.uploadedById` at the moment the job runs. Whoever submitted the
/// work owns its cost — the alternative is a bill attributed to nobody, which
/// is exactly the number an owner cannot act on.
///
/// One row per call rather than a running total per job. A total is a number
/// that can only ever be wrong in ways nobody can reconstruct; rows can be
/// grouped into any total later, and a run of a hundred clauses writing a
/// hundred rows costs nothing next to the hundred model calls it just made.
model TokenUsage {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Null when the work cannot be traced to a person — a document uploaded
  /// before this column existed, or an account since deleted. Counted in the
  /// organisation's total either way, and shown as unattributed rather than
  /// quietly dropped.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Deliberately not foreign keys. Usage outlives the thing that caused it:
  /// deleting a document must not erase the record of what it cost, or the
  /// month's spend changes retrospectively every time someone tidies up.
  documentId String?
  runId      String?

  /// "parse" | "chunk" | "embed" | "analyse" | "app"
  stage String
  /// "llm" | "embedding"
  kind  String

  provider String
  model    String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  /// The part of `inputTokens` the provider served from its prompt cache, and
  /// the part it wrote into that cache. A breakdown of the input figure, never
  /// an addition to it.
  ///
  /// Recorded because input alone cannot price a run. A whole-document
  /// assessment sends the same design as a cached prefix once per clause, so
  /// on a 170-clause run the document is billed either once or 170 times and
  /// `inputTokens` reads the same either way — while a cache read costs a
  /// quarter to a half of ordinary input. Zero means the provider reported
  /// nothing or nothing hit; the two are not told apart here.
  cachedTokens     Int @default(0)
  cacheWriteTokens Int @default(0)

  /// True when the provider returned no usage figures and these were derived
  /// from input size — every embedding endpoint here does that. Flagged rather
  /// than blended in, so a spend figure can say how much of itself is a guess.
  estimated Boolean @default(false)

  /// Which key the provider billed: "platform" for the deployment's own, and
  /// "organisation" when the customer brought their own and paid directly.
  ///
  /// Without this the operator console counts a customer's own provider bill as
  /// the platform's spend, which is wrong in both directions at once — it
  /// overstates what the product costs to run and invites billing a customer
  /// for tokens they already paid for. Tokens are still recorded either way:
  /// an administrator wants to know what their assessments consumed regardless
  /// of which card the provider charged.
  payer String @default("platform")

  createdAt DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([organisationId, userId])
  @@index([documentId])
  @@map("token_usage")
}

/// A piece of work: one design under review, or a design and the revisions
/// that follow it, measured against the organisation's standards.
///
/// Employees open these and put their submissions inside. Reference standards
/// deliberately do *not* belong to one — they are the organisation's rules,
/// curated by its administrator, and every project is measured against the
/// same set. A standard that belonged to a project would quietly become a
/// different yardstick per project, which is the opposite of what a standard
/// is for.
///
/// Archived rather than deleted. A project holds documents, findings and
/// recorded decisions; deleting one would take the record of a review with it,
/// and "we assessed this in March" is exactly what an audit asks about.
model Project {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name        String
  description String @default("")

  /// Whether submitted designs describe one system together or are independent
  /// alternatives. This is explicit assessment scope, never inferred from prose.
  designRelationship String @default("components")

  /// "active" | "archived"
  status String @default("active")

  /// Who opened it. Nullable, and paired with a denormalised name, for the same
  /// reason as Decision.decidedByName: the record has to keep saying who
  /// started this after their account is gone.
  createdById   String?
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  /// Assessments of the project as a whole. A design's own runs hang off the
  /// document, not here.
  runs      AssessmentRun[]
  /// Rulings that apply to this project alone — a breach the board allowed for
  /// this piece of work and nowhere else. See Decision.scope.
  decisions Decision[]

  /// Architecture requests filed against this piece of work. A project is the
  /// container and routinely holds several — which is why a request names the
  /// project it belongs to rather than founding one from its own title: two
  /// requests sharing a title is ordinary, and `@@unique([organisationId,
  /// name])` on this model would refuse the second one.
  requests ArchitectureRequest[]

  /// One name per organisation. Two projects called "Portal" in the same
  /// workspace is a support ticket waiting to happen, and the constraint gives
  /// the create form something specific to say instead of silently making a
  /// second one.
  @@unique([organisationId, name])
  @@index([organisationId, status])
  @@map("project")
}

model Document {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The piece of work this belongs to.
  ///
  /// Null for reference standards, which are organisation-wide by design, and
  /// null for designs that predate projects — the backfill gives those a home,
  /// but the column stays optional because standards legitimately have none.
  ///
  /// `SetNull` rather than a cascade: a project is archived, not deleted, but
  /// if one ever is removed the submissions inside it must not go with it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Who submitted it. Nullable because the column arrived after the first
  /// documents did, and because the account may since have been deleted.
  ///
  /// This is what makes per-person spend possible: a worker running a job knows
  /// the document, and the document knows the person. `onDelete: SetNull` so
  /// removing an employee does not take their organisation's documents with
  /// them — the work belongs to the customer, not to the individual.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // "reference"  — a standards document; stops after embed.
  // "assessed"   — a design submitted for review; continues into analyse.
  // "technology" — a technology stack. Ingests like a reference document
  //                (parse, chunk, embed) so its prose stays searchable, but it
  //                states what is *approved* rather than what is required: it
  //                yields Technology rows instead of clauses, is never
  //                assessed against, and is not a reference standard a
  //                framework can be built from. Set by the parse stage from
  //                what the file turned out to be, not by the uploader. See
  //                the Technology model.
  role String @default("reference")

  /// Which register of the product's own baseline library this copy was —
  /// "security", "data", "integration" and so on. **Vestigial: nothing writes
  /// it any more.**
  ///
  /// The baseline library it named, its seeder and the onboarding panel that
  /// offered it were all deleted on 2026-11-13; the client's own registers are
  /// the only standards this product uses, and every document now arrives by
  /// upload. The column stays rather than being dropped so that rows written
  /// while it meant something keep saying what they said. Read it defensively
  /// and do not add a writer without reviving the library it refers to.
  ///
  /// It was deliberately not `isBaseline` on Framework: that models a second
  /// *layer* assessed alongside the customer's own, and nothing wrote it. What
  /// was chosen here was replacement — a customer with their own Data
  /// standards removed ours and uploaded theirs.
  suppliedKey String?

  title         String
  // Cover-page identifiers, when the document carries them: "DOC-SEC-STD", "V-1.0".
  docCode       String?
  version       String?
  effectiveDate String?

  // Lifted off the page footer during parse, not typed by a human. Drives
  // access control — see Data Standards §8.1.
  sensitivity String?

  // Object-storage key, not a URL: the bucket may be private and the signing
  // scheme may change.
  storageKey String
  mimeType   String @default("application/pdf")
  byteSize   Int
  // Content hash. Re-uploading the same bytes must not re-parse or re-embed.
  sha256     String

  pageCount Int?
  // "prose-clause" | "table-principle" | "mixed" — detected, not declared.
  profile   String?

  /// What this document as a whole is trying to do, written once from the whole
  /// of it — see the summarise pass in Workers/aidp/stages/chunk.py.
  ///
  /// Retrieval hands the judge eight passages and nothing else, and the judge
  /// prompt says so: "you cannot see the rest of the document". That is
  /// survivable for a standard, whose clauses are self-contained by
  /// construction. It is not survivable for a submission. A deck comparing two
  /// vendors for a B2B payments programme reads, eight passages at a time, as
  /// unrelated claims about two products, and a verdict reached that way
  /// answers a question nobody asked.
  ///
  /// So the document's own purpose is written down once and travels with every
  /// clause. Null when no model was configured at chunk time; the judge simply
  /// goes without, exactly as it did before this existed.
  summary String?

  /// True when this document's structure or rules were read by a model rather
  /// than parsed from its own formatting — see Workers/aidp/parsing/ai_structure.py
  /// and rules.py.
  ///
  /// A record of how the document was read, and nothing more. It once gated
  /// assessment on a person confirming the reading, but a model now reads every
  /// standard, deck and workbook, so the gate stood in front of every upload.
  /// The two confirmation columns stay so documents confirmed under it still
  /// say so; nothing writes them any more.
  structureInferred    Boolean   @default(false)
  structureConfirmedAt DateTime?
  structureConfirmedBy String?

  // "pending" | "parsing" | "chunking" | "embedding" | "ready" | "failed"
  status        String  @default("pending")
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections           DocumentSection[]
  chunks             Chunk[]
  jobs               Job[]
  // Populated only for role="technology": the stack's rows.
  technologies       Technology[]
  issues             IngestIssue[]
  assessmentFindings Finding[]

  // A reference standard's text as numbered lines, and every model reading of
  // its rules. See Workers/aidp/parsing/rules.py.
  sourceLines     SourceLine[]
  ruleExtractions RuleExtraction[]
  lineLabels      LineLabel[]

  // Reference documents belong to frameworks; assessed documents get runs.
  frameworks FrameworkDocument[]
  runs       AssessmentRun[]

  // One live document per organisation per file. A second upload of the same
  // bytes resolves to this row instead of starting the pipeline again.
  @@unique([organisationId, sha256])
  @@index([organisationId, status])
  /// Supported "which of our registers is this organisation still running on?"
  /// for the library screen and the seeder, both since deleted. Kept with the
  /// column it indexes — see `suppliedKey` — and dropping it is a migration
  /// nobody needs today.
  @@index([organisationId, suppliedKey])
  @@map("document")
}

model DocumentSection {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Reading order within the document. This is the identity, not `numberText`:
  // real documents repeat section numbers (the sample corpus has two 9.1.1s
  // from Word auto-numbering drift).
  ordinal     Int
  // "3.2", "Appendix A" — as printed, for display and citation only.
  numberText  String?
  title       String
  // "Security Standards › 3. Identity and Access Management › 3.2 Authentication"
  headingPath String
  depth       Int     @default(1)

  pageStart Int?
  pageEnd   Int?

  // Prose that belongs to the section itself rather than to any clause. Also
  // the parent chunk when a query is broader than a single clause.
  introText String @default("")

  // No clause, no table, no figure, no prose. Surfaced as an issue rather than
  // silently dropped — a compliance tool that swallows an empty section will
  // later answer from a sibling document and sound certain.
  isEmpty Boolean @default(false)

  clauses Clause[]
  tables  TableBlock[]
  figures Figure[]

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("document_section")
}

model Clause {
  id String @id @default(cuid())

  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  ordinal Int
  title   String?

  // The template's own four parts. `guidance` only appears in Solution
  // Architecture, which pairs each standard with the technologies to implement
  // it — the prescription attached to the diagnosis.
  statement    String   @default("")
  rationale    String   @default("")
  requirements String[] @default([])
  guidance     String[] @default([])

  pageStart Int?
  pageEnd   Int?

  // "parser" when the rule-based parser found it by its shape; "model" when a
  // model pointed at the lines and code sliced the text (see
  // Workers/aidp/parsing/rules.py); "restored" when a reviewer promoted lines
  // the model had set aside; "authored" when a reviewer sharpened an earlier
  // version of this clause from what an assessment found (see ClauseDraft);
  // "register" when the source was a standards register — a workbook stating
  // one standard per row, read without inference by
  // Workers/aidp/parsing/registers.py. A register clause carries a statement
  // and a rationale and no `requirements`, because the register states none;
  // `sourceRefs.register` holds its identifier, category, status and owner.
  origin     String @default("parser")
  /// Where this clause stands in this organisation's library: "active" or
  /// "suspended". See CLAUSE_STATUSES in lib/ingest/standards-vocabulary.
  ///
  /// Defaults to active, because a register somebody uploaded is a library they
  /// chose — silently judging nothing would be the worse surprise.
  ///
  /// A suspended clause is not judged, does not reach a report and does not
  /// count toward a run's clause total. Read at the top of the clause query in
  /// Workers/aidp/stages/analyse.py, which is the one place it takes effect.
  ///
  /// **Changed here and nowhere else.** An administrator sets it directly from
  /// the standards library, and `clause_status_change` records every move. It
  /// deliberately does *not* go through the decision register: decisions are
  /// how a new standard is promoted *into* the library, and a standard already
  /// in the library must never travel back the other way — there is one
  /// direction, and this is the far end of it.
  ///
  /// Per organisation without a join table, because each customer uploads their
  /// own copy of a register and so owns its clause rows outright.
  status     String @default("active")
  // For a model-read or restored clause, the source line refs each part came
  // from: { span, heading, statement, rationale,
  // requirements: [{ refs, strength }], guidance, references }.
  sourceRefs Json?

  /// Replaced by a sharper version of itself, and no longer judged.
  ///
  /// A clause is never edited in place, for the reason the register gives: a
  /// `Finding` denormalises the clause's ref, title and statement but *not* its
  /// requirements — and requirements are exactly what sharpening adds. Rewrite
  /// one in place and the report from six months ago says "covered" against a
  /// clause whose requirements no longer exist anywhere, which is the one thing
  /// an assessment has to be able to answer for.
  ///
  /// So the old row stays exactly as it was, keeps its ordinal, and stops being
  /// judged, while the sharper version is appended at the end of its section's
  /// reading order exactly as a restored rule is. The clause reference does not
  /// move with it: that comes from the *section's* number, which is why a
  /// decision anchored to §9.3 still finds the sharpened clause.
  ///
  /// `@@unique([sectionId, ordinal])` is therefore a *partial* unique index in
  /// the migration — one live clause per ordinal, any number of superseded ones
  /// behind it, and an ordinal a superseded row vacated is free again. Prisma
  /// cannot express that, which is why it is not declared here; see
  /// `isUniqueViolation` in the documents actions for the 23505 that surfaces
  /// instead of Prisma's P2002.
  supersededById String? @unique
  supersededBy   Clause? @relation("ClauseSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Clause? @relation("ClauseSupersedes")

  /// Where an `authored` clause came from: the reviewed finding that showed the
  /// earlier wording was not specific enough to judge against, and its run.
  /// Not foreign keys, and for the same reason `Finding.clauseId` is not one —
  /// a clause has to outlive the report that prompted it.
  sourceFindingId String?
  sourceRunId     String?
  /// Kept beside the relation-free ids so the library still attributes the
  /// wording after the person who approved it has left — the same reasoning as
  /// `Decision.decidedByName`.
  authoredByName  String    @default("")
  authoredAt      DateTime?

  tables TableBlock[]
  drafts ClauseDraft[]

  /// Reading order within a section, and the only index the clause lookups
  /// need: every one of them starts from a section and filters the superseded
  /// out. The uniqueness of a live ordinal is enforced by the partial index in
  /// the migration, not here.
  @@index([sectionId, supersededById])
  @@index([sectionId])
  @@map("clause")
}

/// A sharper version of one clause, proposed from one assessment, not yet live.
///
/// The gap this fills: a customer's standards library is not only small, it is
/// vague. "Ensure resilience" cannot be judged, so a design that retries
/// without a dead-letter path comes back `partial` for ever and nobody writes
/// down what the clause actually meant. A reviewer who has just confirmed that
/// verdict knows what it meant, and this is the shortest path from knowing it
/// to the library saying it.
///
/// Deliberately a staging table rather than a direct edit:
///
///  1. **A model drafts, a person decides.** The requirements are written by a
///     model from the clause and the finding, then checked (see
///     Workers/aidp/standards.py) and shown for approval. Nothing reaches the
///     library that a person has not read.
///  2. **One place to see what is pending.** A library that gained a
///     requirement every time somebody confirmed a verdict would be a library
///     nobody could review.
model ClauseDraft {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The clause this sharpens. Cascades: a draft against a clause that a
  /// re-parse has removed is proposing an addition to something that no longer
  /// exists, and keeping it would offer the reviewer a dead end.
  clauseId String
  clause   Clause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  /// Denormalised so the queue still reads correctly beside a clause that has
  /// since been superseded by somebody else's draft.
  clauseRef   String @default("")
  clauseTitle String @default("")

  /// What the proposal is asking for. Only "sharpen" is written — see
  /// DRAFT_KINDS in lib/ingest/standards-vocabulary.
  ///
  /// It briefly also carried "adoption", for proposals that a clause be
  /// accepted into or rejected from the library. That was removed: a standard
  /// already in the library must never go back to the decision register, and
  /// whether a clause is in force is now set directly on the clause (see
  /// Clause.status) and recorded in clause_status_change. The column stays
  /// because the rows that used it may still be on disk, and because a second
  /// kind of proposal is a plausible thing to want again.
  kind String @default("sharpen")

  /// Vestigial, and never written any more: the state an adoption proposal
  /// asked for. Kept rather than dropped so that no historical row loses what
  /// it said. Nothing reads it.
  proposedAdoption String @default("")

  /// The reviewed finding that prompted it, and its run. Relation-free for the
  /// same reason as Clause.sourceFindingId.
  ///
  /// Null only on a historical adoption proposal, which was raised from the
  /// library rather than from a finding. Every proposal written now comes from
  /// a reviewed finding and carries both.
  sourceFindingId String?
  sourceRunId     String?

  /// The verdict that finding carried when this was asked for — "partial" or
  /// "contradicts". Denormalised rather than read back off the finding, for the
  /// same reason `clauseRef` is: a proposal has to keep stating its own case
  /// after the finding behind it has been corrected, re-run or removed.
  ///
  /// It is also the rule for how this may be published. A `partial` means the
  /// clause could not be judged as written, so there is one sensible outcome —
  /// the clause gets sharper. A `contradicts` is different: the design broke a
  /// rule, and what the breach shows may be that a *second*, separate rule was
  /// missing rather than that this one was vague. So a contradiction may be
  /// published either way, and a partial only as a sharpening. See
  /// `PUBLISH_MODES` in src/lib/ingest/standards.ts.
  sourceVerdict String @default("")

  /// "drafting"  — queued, or a worker is on it
  /// "ready"     — requirements written and checked, waiting for a person.
  ///               This is what the register shows as *pending review*.
  /// "approved"  — a person has read it and agreed the wording. Not yet in the
  ///               library: approving and publishing are deliberately two acts.
  /// "failed"    — the model could not be reached, or wrote nothing usable
  /// "applied"   — published. A new clause carries these requirements and the
  ///               old one has been superseded.
  /// "discarded" — a person read it and said no
  ///
  /// The gate is `ready -> approved -> applied`, and it is two steps on
  /// purpose. Approving says the proposed wording is right; publishing changes
  /// what every future assessment in this organisation measures against. One
  /// button doing both means the second, irreversible half happens as a side
  /// effect of agreeing with a sentence — and it lets one person sign off the
  /// wording while another decides the library is ready to carry it.
  ///
  /// The workers only ever write "ready" or "failed", and only act on a row in
  /// "drafting" (Workers/aidp/standards.py), so nothing downstream of the draft
  /// can be moved by a worker.
  state String @default("drafting")

  /// The requirement lines proposed, in the words a standard would use. Only
  /// ever additions: the statement and rationale of the clause are left alone,
  /// because a model allowed to rewrite the rule would quietly change what the
  /// customer requires. See the prompt in Workers/aidp/ai/llm.py.
  requirements String[] @default([])

  /// The model's one line on what the earlier wording left unsaid. Shown to the
  /// reviewer as the case for the change, never stored on the clause.
  note String @default("")

  model String?
  error String?

  /// Lines the model proposed that the checks refused, each with the reason —
  /// not normative, already in the clause, or lifted from the design rather
  /// than written as a rule. Kept so a reviewer can see what was thrown away
  /// instead of wondering why one requirement came back.
  setAside Json @default("[]")

  /// The register row this proposal would become, as the worker drafted and
  /// checked it: `{ identifier, parentIdentifier, category, owner, status,
  /// title, statement, rationale }`.
  ///
  /// Six of this organisation's standards are kept as spreadsheets, and every
  /// rule in them is a row with those columns. A proposal that carried only
  /// requirement lines could not be filed back beside them: publishing it as a
  /// rule of its own meant an approver hand-typing a title and a statement
  /// with no reference, no category and no owner, and the row landed in the
  /// library as an orphan. This is that row, drafted.
  ///
  /// `identifier` is derived in code, never by the model — "DAT-004a" beside
  /// "DAT-004", so a reference somebody has already cited in a design or a
  /// waiver cannot be made to point somewhere else. `status` is always
  /// "proposed" here; only publishing can make it anything else.
  ///
  /// Empty `{}` for a clause parsed from prose rather than a register, and for
  /// every draft written before this column existed. Read it defensively.
  entry Json @default("{}")

  /// The clause publishing created. Null until then.
  appliedClauseId String?

  /// How it was published: "sharpen" (the clause gained the lines as a new
  /// version of itself, superseding the old) or "separate" (a new clause was
  /// added beside it and the original left standing). Empty until published.
  ///
  /// Recorded because the two leave the library in genuinely different states
  /// and a reader of the register a year later cannot tell which happened by
  /// looking at the clause — one shows a superseded predecessor, the other
  /// shows nothing at all.
  publishMode String @default("")

  /// Who agreed the wording, and when. Set on the move to "approved".
  ///
  /// Nullable with a denormalised name beside it, as everywhere else a person
  /// is recorded in this schema: the register has to keep saying who approved a
  /// standard after their account is gone, which is exactly what an audit of
  /// the standards library asks.
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?     @relation("ClauseDraftApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByName String    @default("")

  /// Who put it into the library, and when. Set on the move to "applied".
  ///
  /// Kept separate from the approval above because they are two different acts
  /// by two possibly different people, and "approved in March, published in
  /// June" is a real and ordinary sequence that one timestamp cannot express.
  publishedAt     DateTime?
  publishedById   String?
  publishedBy     User?     @relation("ClauseDraftPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedByName String    @default("")

  requestedById   String?
  requestedBy     User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live draft per finding. A reviewer pressing twice must not queue two
  /// model calls against the same clause, and two drafts of one finding would
  /// read as two independent proposals agreeing.
  @@index([organisationId, state])
  @@index([clauseId])
  /// Both support the `SetNull` on the approver and publisher above: without
  /// them, deleting a user sequentially scans this table once per row removed.
  ///
  /// Declared here as well as created in 20261106150000_clause_draft_approval,
  /// which is the whole point. An index the database holds and the schema does
  /// not is one `prisma migrate` offers to drop as collateral on the next
  /// unrelated change — the same trap 20261023120000 had to write a paragraph
  /// about after three of them went undeclared.
  @@index([approvedById])
  @@index([publishedById])
  @@map("clause_draft")
}

// ---------------------------------------------------------------------------
// Rules read by a model
//
// A standard's rules are read by a model that is only allowed to point: it sees
// numbered lines and answers with line numbers. Code checks every number and
// slices the words itself, so no rule can contain text the document does not.
// These tables keep the evidence — the text as read, every reading, and what
// was set aside with the model's stated reason — so a reviewer can see why a
// line is or is not a rule, and a disagreement can be traced after the fact.
// ---------------------------------------------------------------------------

/// One row of a technology stack: a technology this organisation has taken a
/// position on, and what that position is.
///
/// Not a Clause, and deliberately so. A standards register states rules — one
/// row is one obligation, with a statement a design can breach. A technology
/// stack states *facts about what is approved*: "Amazon Redshift, Hold,
/// RA3 / Serverless". There is nothing in a stack row for a design to comply
/// with, which is why `registers.detect` refuses the stack template rather
/// than ingesting its rows as standards — see the note there.
///
/// It is consulted a different way too. A standards run walks every clause and
/// asks the model for a verdict. A stack is matched: the technologies a design
/// names are looked up here, and what is flagged is a name sitting on `hold`,
/// a name absent from the stack altogether, or a version outside the approved
/// range. No model is needed to decide any of those.
model Technology {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The stack document this row was read out of. A re-parse replaces the
  /// rows of that document and nothing else.
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// "Amazon Web Services (AWS)". The stack has no identifier column — the
  /// name is the identity, which is why it is unique per document.
  name     String
  category String @default("")

  /// "adopt" | "trial" | "assess" | "hold" — see TECH_STATUSES in
  /// src/lib/ingest/technology-vocabulary.ts. Stored lower-case; the workbook
  /// writes them capitalised.
  ///
  /// Unlike a standards register's Status column, this one ships populated:
  /// all 215 rows of the template carry a position. So there is no "unstated"
  /// here, and an unreadable value is kept as `assess` — the status that
  /// asserts least.
  status String @default("assess")

  /// "19c", "8.4 LTS", "N/A (managed)". Free text, because the column is.
  approvedVersions String @default("")
  justification    String @default("")
  /// The stack's "Scenarios in which this needs to be used" column.
  scenarios        String @default("")
  owner            String @default("")
  addedDate        String @default("")
  lastReviewedDate String @default("")
  notes            String @default("")

  /// Position in the sheet, so the list reads in the order it was written.
  ordinal Int

  changes TechnologyChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The name is the identity, so a re-parse updates a row rather than
  /// duplicating it, and two sheets naming the same technology collapse.
  @@unique([documentId, name])
  @@index([organisationId, status])
  @@map("technology")
}

/// Every change of a technology's status, kept for good.
///
/// Status decides what the next assessment flags: moving something off `hold`
/// silently stops a breach being reported. A dropdown that changes what the
/// product will say about future designs, with no record of who changed it or
/// when, is the kind of gap a compliance tool cannot have — so each edit
/// appends a row here and nothing ever updates one.
///
/// The ingest writes one too, with `byName` empty and `from` blank: the first
/// position a technology held came from the workbook, and a history that
/// starts at the first human edit cannot say where the original value came
/// from.
model TechnologyChange {
  id String @id @default(cuid())

  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  /// Empty on the row the ingest writes — there was no previous position.
  from String @default("")
  to   String

  /// Null once the user is deleted; the name is kept so the record still reads.
  byId   String?
  by     User?   @relation(fields: [byId], references: [id], onDelete: SetNull)
  byName String  @default("")

  /// "ingested" when the workbook said so, "edited" when a person did.
  source String @default("edited")

  note String @default("")

  createdAt DateTime @default(now())

  @@index([technologyId, createdAt])
  @@index([byId])
  @@map("technology_change")
}

/// One administrator's change to a clause's standing in the library.
///
/// Append-only, and the reason it exists is the same reason the decision
/// register exists for everything else: suspending a clause changes what every
/// future assessment measures, and a change of that weight that leaves no trace
/// is not one anybody can review afterwards.
///
/// `clauseId` carries **no relation**, deliberately. A clause dies when its
/// document is re-parsed or removed, and `ClauseDraft` cascades for exactly
/// that reason — but a draft describes a proposal about a clause, while this
/// describes an administrative act by a person, and that act has to outlive the
/// row it was about. The same argument makes Finding.clauseId a plain string.
model ClauseStatusChange {
  id String @id @default(cuid())

  /// Not a foreign key — see the note above.
  clauseId  String
  /// Denormalised so the record still reads once the clause is gone.
  clauseRef String @default("")

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  from String
  to   String

  /// Why. Required by the action rather than by the column, because a column
  /// that permits an empty string is one every caller eventually passes an
  /// empty string to.
  reason String @default("")

  /// Null once the user is deleted; the name is kept so the record still reads.
  byId   String?
  by     User?   @relation(fields: [byId], references: [id], onDelete: SetNull)
  byName String  @default("")

  createdAt DateTime @default(now())

  @@index([clauseId, createdAt])
  @@index([organisationId, createdAt])
  @@index([byId])
  @@map("clause_status_change")
}

model SourceLine {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Position in the document from 0 — the number the model saw and answered in.
  ordinal        Int
  // The same position for people: "L12" is the twelfth paragraph, "T3-r4" the
  // fourth row of the third table, "T3-h" that table's column line.
  ref            String
  // "text" | "heading" | "bullet" | "table_header" | "table_row"
  kind           String
  page           Int?
  text           String
  // The section the line falls in, by ordinal, as the parse left it.
  sectionOrdinal Int?
  // Heading depth, when the document declared one.
  depth          Int?

  @@unique([documentId, ordinal])
  @@map("source_line")
}

model RuleExtraction {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // 1 is the first reading; 2 is the cross-check, or the retry when 1 failed.
  attempt       Int
  // "accepted" | "failed"
  status        String
  // Whether this reading's rules are the clauses stored for the document.
  adopted       Boolean @default(false)
  provider      String
  model         String
  promptVersion String
  error         String?
  // Lines, lines covered, rules, requirements, lines set aside per label.
  stats         Json    @default("{}")
  // Every request made for this reading: the line range, whether it was
  // believed and why not, and the raw reply — line numbers and short reasons.
  calls         Json    @default("[]")

  createdAt DateTime @default(now())

  labels LineLabel[]

  @@index([documentId])
  @@map("rule_extraction")
}

model LineLabel {
  id String @id @default(cuid())

  extractionId String
  extraction   RuleExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Inclusive range of SourceLine ordinals.
  fromOrdinal Int
  toOrdinal   Int
  // "furniture" | "scope" | "reference" | "process_rule" | "guidance" | "other"
  label       String
  // The model's own words for what these lines are.
  reason      String @default("")

  // Set when a reviewer decided these lines are a rule after all.
  restoredAt       DateTime?
  restoredBy       String?
  restoredClauseId String?

  @@index([documentId])
  @@index([extractionId])
  @@map("line_label")
}

model TableBlock {
  id String @id @default(cuid())

  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  // Set when the table belongs to a specific standard rather than to the
  // section at large — Security §3.2 carries its password policy inside the
  // clause, not beside it.
  clauseId  String?
  clause    Clause?         @relation(fields: [clauseId], references: [id], onDelete: SetNull)

  ordinal Int
  caption String?

  columns String[] @default([])
  // Array of objects keyed by column header. Empty cells are stored as null,
  // never omitted: drop them and every later value shifts one column left,
  // turning "not specified" into the previous row's answer.
  rows    Json     @default("[]")

  pageStart  Int?
  pageEnd    Int?
  // Extraction confidence. Low values raise an IngestIssue for review.
  confidence Float @default(1)

  @@index([sectionId])
  @@map("table_block")
}

model Figure {
  id String @id @default(cuid())

  sectionId String
  section   DocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  ordinal Int
  page    Int
  // [x0, y0, x1, y1] in PDF points, so a citation can highlight the region.
  bbox    Float[] @default([])

  storageKey  String
  caption     String?
  // The model's description of the diagram. For vector-drawn figures this is
  // the only searchable text that exists — the PDF text layer under them is
  // empty.
  //
  // It is also *generated*, and once it becomes a chunk nothing distinguishes it
  // from text lifted off the page. That is the risk worth designing against: not
  // a corrupted index — embeddings are per-chunk, and a bad one re-embeds for a
  // single API call — but fabricated evidence that reads like a quotation.
  description String  @default("")

  // A human's correction, when the model got it wrong. Kept beside the original
  // rather than overwriting it, so the disagreement stays visible and the vision
  // model's accuracy stays measurable.
  correctedDescription String?

  // "pending" | "confirmed" | "corrected" | "rejected"
  //
  // Review is deliberately non-blocking: the document indexes immediately and a
  // figure is reviewed when someone has reason to care. Gating ingestion on it
  // would put a queue of human work in front of every upload — twenty decisions
  // before a customer's library is searchable at all.
  reviewState String    @default("pending")
  reviewNote  String?
  reviewedAt  DateTime?

  // Drawing primitives plus text runs inside the region. A dense diagram is
  // where vision models actually struggle; a three-box flow is not. Sorts the
  // review queue by risk rather than by page order.
  complexity Int @default(0)

  @@index([sectionId])
  @@map("figure")
}

model Chunk {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // "clause" | "table_row" | "table" | "figure" | "section"
  sourceKind String
  // Row id of the clause/table/figure this came from. Not a foreign key: one
  // column can't reference four tables, and the cascade already runs through
  // documentId.
  sourceId   String?

  ordinal     Int
  headingPath String
  // What gets embedded: heading path, contextual preamble, then the body.
  text        String
  tokenCount  Int     @default(0)
  // Inherited from the document. Filtered on at query time so Restricted
  // material can't surface through a broad question.
  sensitivity String?

  pageStart Int?
  pageEnd   Int?

  // Hash of the text. Unchanged chunks are not re-embedded on re-parse.
  contentHash String

  embeddings Embedding[]

  @@unique([documentId, ordinal])
  @@index([organisationId])
  @@index([documentId])
  @@map("chunk")
}

model Embedding {
  id String @id @default(cuid())

  chunkId String
  chunk   Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  // Recorded per row so a model change can be rolled out side-by-side instead
  // of as a big-bang re-embed.
  model String
  dims  Int

  // pgvector. Prisma has no native type for it, so the column is declared here
  // and written by raw SQL from the Python worker. The HNSW index lives in the
  // migration.
  vector Unsupported("vector(1024)")?

  createdAt DateTime @default(now())

  @@unique([chunkId, model])
  @@map("embedding")
}

model Job {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The document this job is about.
  ///
  /// Null on an analyse job for a project run, which is about every design in
  /// the project rather than one of them; those are found by the run id on
  /// `payload` instead. Every parse, chunk and embed job has one by
  /// construction — they are the stages that read a file.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // "parse" | "chunk" | "embed" | "analyse"
  stage String
  // "queued" | "leased" | "done" | "failed" | "dead"
  state String @default("queued")

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  // Backoff target. A retry is invisible to claimers until now() passes this.
  runAfter   DateTime  @default(now())
  leaseUntil DateTime?
  leaseOwner String?

  // Follows a document across every stage. Required by Data Standards §9.3 and
  // the customer's own Integration principle 12.
  correlationId String
  payload       Json    @default("{}")
  lastError     String?
  // What the worker holding the job is doing: step, done/total, finished steps
  // and when the attempt started. See Workers/aidp/progress.py and
  // src/lib/ingest/pipeline.ts. Only a courtesy — nothing gates on it.
  progress      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, state, runAfter])
  @@index([state, leaseUntil])
  @@index([documentId])
  @@map("job")
}

model IngestIssue {
  id String @id @default(cuid())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // "high" | "medium" | "low"
  severity   String
  // "section_missing" | "section_empty" | "toc_mismatch" | "table_low_confidence"
  // | "figure_undescribed" | "needs_ocr"
  kind       String
  detail     String
  // Where in the document, when we know.
  page       Int?
  sectionRef String?

  createdAt DateTime @default(now())

  @@index([documentId, severity])
  @@map("ingest_issue")
}

// ---------------------------------------------------------------------------
// Assessment
//
// This is the product. Retrieval runs backwards from the usual shape: the
// reference clause is the query, not the user. For each of the ~120 clauses in
// a customer's framework, the analyse worker searches the submitted design and
// classifies what it finds. Nobody types a question.
//
// A run pins the framework version it ran against, because a finding that says
// "breaches §3.2" is meaningless once §3.2 has been rewritten.
// ---------------------------------------------------------------------------

/// A versioned set of reference documents — what assessments measure against.
model Framework {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name    String
  version Int    @default(1)

  /// The consultancy's house standard rather than the customer's own. Findings
  /// record which layer a clause came from: "breaches your own standard" and
  /// "below industry baseline" are different conversations in a review.
  isBaseline Boolean @default(false)

  /// When this version stopped being the one to assess against, because a
  /// standard in it was removed from the library.
  ///
  /// Needed because the membership rows cascade away with the document, so the
  /// set comparison in `resolveFramework` cannot see that anything changed —
  /// the evidence went with the deletion. Without this the same framework id
  /// quietly came to mean a smaller set of standards than the runs pinned to it
  /// were measured against, which is the one thing versioning them exists to
  /// prevent. A superseded version is never reused; it stays readable, and the
  /// runs that used it keep their own clause counts.
  supersededAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents FrameworkDocument[]
  runs      AssessmentRun[]

  @@unique([organisationId, name, version])
  @@index([organisationId])
  /// `resolveFramework` asks for the newest version that has not been
  /// superseded, on every assessment. Created in 20261007090000_framework_superseded.
  @@index([organisationId, supersededAt])
  @@map("framework")
}

model FrameworkDocument {
  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@id([frameworkId, documentId])
  @@index([documentId])
  @@map("framework_document")
}

model AssessmentRun {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The submission under assessment — a document with role='assessed'.
  ///
  /// Null on a project run, which assesses every design in a project at once:
  /// there is no single submission then, and `projectId` says what the scope
  /// was. Exactly one of the two is set, which `startProjectAssessment` and the
  /// worker's `designs()` both rely on.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The project under assessment, when every design in it was read together.
  ///
  /// A clause is judged once against all of them, because a design document
  /// rarely stands alone: what one deck leaves out the next one answers, and
  /// per-document runs reported those as gaps. Null on a single-design run.
  ///
  /// `SetNull` for the same reason as Document.projectId: a project is archived,
  /// not deleted, and a report must outlive one if it ever is removed.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// "components" | "alternatives" — how this run read its designs.
  ///
  /// Copied from the project when the run is opened rather than read back off
  /// it, for the same reason the framework is pinned: a project's owner can
  /// change the relationship afterwards, and a report has to keep explaining
  /// the verdicts it actually produced. A run judged as rival candidates says
  /// so forever, even once the project has been switched to one solution.
  ///
  /// Single-design runs snapshot their project's setting too. Historical runs
  /// default to components because that is how they were assessed.
  designRelationship String   @default("components")
  /// Ready design IDs selected when this run was created. Resumes cannot absorb
  /// a later upload or a document that was still indexing when the run began.
  designIds          String[] @default([])
  /// IDs present but not ready at run creation, kept separate so later indexing
  /// cannot silently add them to this run's assessed scope.
  unreadyDesignIds   String[] @default([])

  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  // "queued" | "running" | "complete" | "failed"
  state String @default("queued")

  /// Progress, so a run over a hundred clauses can show more than a spinner.
  totalClauses     Int @default(0)
  completedClauses Int @default(0)

  /// Recorded per run: a verdict is only interpretable alongside the model that
  /// reached it, and these will be re-run as models change.
  model         String?
  failureReason String?

  // How the judge saw the design. "retrieval": the passages a search found for
  // each clause. "document": the whole document, quoted, with every quote
  // checked word for word against it. See Workers/aidp/whole_document.py.
  // "auto" — the default — is the worker choosing between the two rather than a
  // third way of reading a design. Which one a design can have is a question
  // about its token count, and nobody pressing "assess" knows that: a single
  // design is read whole when it fits and searched when it does not, and `note`
  // says which happened. An explicit "retrieval" is still honoured, and a
  // project run sets "retrieval" itself. See `_resolve_mode`.
  mode           String  @default("auto")
  // Anything a reader of these results needs to know about how they were
  // reached — above all, a whole-document run that fell back to search.
  note           String?
  // The run this one was started alongside, when both modes were run to be
  // compared.
  comparedWithId String?
  // The reverse of the findings: parts of the design no clause governs, each
  // with a quote checked against the design, and the standards a model suggests
  // adding. See Workers/aidp/coverage.py and src/lib/ingest/coverage.ts.
  coverage       Json?
  /// Improvements to the design itself, suggested once the clauses are judged and
  /// the coverage worked out — see Workers/aidp/advice.py. Advice, never a
  /// verdict. Null on runs from before it existed.
  advice         Json?
  /// Whether the technologies the design names are still supported, looked up on
  /// endoflife.date by product id alone — see Workers/aidp/lifecycle.py. Facts
  /// with a source and a date, never a verdict. Nullable: runs from before this
  /// existed have none.
  lifecycle      Json?

  /// Which of this run's findings come from one fact about the design, worked
  /// out after every clause is judged — see Workers/aidp/rootcause.py and
  /// src/lib/ingest/root-causes.ts.
  ///
  /// A lens over the findings, never a replacement: each one keeps its clause
  /// reference, its verdict and its own review decision, because a breached
  /// clause has to stay answerable as that clause. Twelve contradictions on one
  /// real run came from five facts, and the report counted twelve pieces of
  /// work. Null on runs from before it existed, which read exactly as they did.
  rootCauses Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  findings Finding[]
  outcomes SubmissionOutcome[]

  @@index([organisationId, state])
  @@index([documentId])
  @@index([projectId, state])
  @@map("assessment_run")
}

model Finding {
  id String @id @default(cuid())

  runId String
  run   AssessmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Which design this result evaluates. Null is retained for historical
  /// project-wide aggregate rows written before per-design assessment.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// Stable upsert scope: the design id for a per-design result, and the empty
  /// string for a legacy aggregate row.
  designKey String @default("")

  /// The reference clause this answers. Not a foreign key to Clause: findings
  /// have to outlive a re-parse of the reference document, and cascading them
  /// away would silently erase a reviewer's decisions.
  clauseId        String
  /// Denormalised so a finding still reads correctly after the source moves.
  clauseRef       String
  clauseTitle     String @default("")
  clauseStatement String @default("")

  // "covered" | "partial" | "absent" | "contradicts" | "needs_review"
  // | "not_assessable" | "not_applicable"
  //
  // `not_assessable` is the design being on the subject with the evidence
  // needed to judge it missing — a named cloud service with no approval record,
  // a network diagram with no firewall policy. It is not a breach and never
  // carries Critical severity. `absent` keeps its narrower meaning: the design
  // never engages the clause's mechanism at all.
  verdict    String
  /// 0–1, from the model. Used to demote a low-confidence "absent" — see
  /// Workers/aidp/stages/analyse.py.
  ///
  /// The model's own opinion of itself, so it is a heuristic and not a
  /// calibrated probability. The worker uses it only in evidence-sufficiency
  /// guards; it is not part of severity and is not shown as a percentage.
  confidence Float  @default(0)
  rationale  String @default("")

  /// How strongly the clause bound, as established when this was judged:
  /// "must" | "should" | "may" | "unstated". See Workers/aidp/obligations.py.
  ///
  /// Denormalised for the same reason as `clauseRef`: severity is a function of
  /// it, and a report has to keep explaining its own severities after the clause
  /// behind them has been sharpened or retired.
  ///
  /// `unstated` is not a synonym for advisory. It means the standard did not
  /// establish the obligation, and the engine will not establish one on its
  /// behalf — so severity says it needs a person rather than inventing a level.
  obligation String @default("unstated")

  /// Where that obligation came from, weakest claim last: "parsed" (the
  /// standard's own recorded structure), "read" (a modal verb in the clause's
  /// own wording), "judge" (the model's reading of the clause it was given), or
  /// "unstated". Stored so a reviewer can see which kind of answer a severity
  /// rests on and disagree with the weaker ones.
  obligationSource String @default("unstated")

  /// [{ chunkId, headingPath, page, excerpt }]. A verdict of covered, partial
  /// or contradicts with no evidence is downgraded, because a claim about a
  /// document that cites nothing in it was invented.
  evidence Json @default("[]")

  /// How well retrieval did before the model saw anything. A confident "absent"
  /// on top of weak retrieval is the failure this exists to catch.
  retrievalScore Float @default(0)

  /// What the model answered, before any guard touched it.
  ///
  /// Everything above is post-guard: `_normalise` may have promoted a breach,
  /// `_guard` may have demoted the verdict and prepended its reason to the
  /// rationale. That is the right thing to show a reviewer and the wrong thing
  /// to keep as the only record, because it meant no guard or prompt change
  /// could be replayed against findings already stored — the inputs those
  /// functions read were gone. Every experiment cost a full run of the
  /// framework, which on the client corpus is 170 model calls.
  ///
  /// Empty and 0 where a finding predates this, which is distinguishable from
  /// a real answer: no model returns an empty verdict.
  rawVerdict    String @default("")
  rawConfidence Float  @default(0)
  rawRationale  String @default("")

  /// How many independent readings of this clause were taken, and how many of
  /// them reached the verdict above.
  ///
  /// A verdict used to be one model call, and a model does not answer the same
  /// question the same way twice — two runs over one design came back 9 absent
  /// and 4 needing review, then 7 and 7. An assessment that moves between
  /// Tuesday and Thursday is not one an architecture board can be shown, so a
  /// clause is read several times and the readings are voted on. See `_vote` in
  /// Workers/aidp/stages/analyse.py, and `coverage.agree`, which has always
  /// done this for the parts of a design no clause governs.
  ///
  /// Readings stop as soon as two agree, so an ordinary clause costs two and
  /// only a contested one costs three. 1/1 is the single-reading behaviour and
  /// is what every finding written before this carries.
  readings Int @default(1)
  agreed   Int @default(1)

  /// [{ verdict, rationale }] — what the readings that disagreed said.
  ///
  /// Kept rather than discarded, for the reason `reviewerVerdict` sits beside
  /// `verdict` rather than over it: the disagreement is the evaluation data,
  /// and a vote with its minority thrown away asserts a confidence the run did
  /// not have. A dissenting "contradicts" under a majority "covered" is the
  /// most useful line on the page for whoever signs the report off.
  dissent Json @default("[]")

  /// [{ id, title, effect }] — the standing decisions that were in the prompt
  /// and that the model said it applied. Denormalised for the same reason as
  /// `evidence`: a report from last year has to keep explaining itself after
  /// the decision behind it has been superseded or deleted.
  appliedDecisions Json @default("[]")

  // "pending" | "confirmed" | "overridden"
  reviewerState   String    @default("pending")
  reviewerVerdict String?
  reviewerNote    String?
  reviewedAt      DateTime?

  /// How strongly the reviewer says the clause binds, where they disagree with
  /// the engine. Null is the normal state and means the engine's `obligation`
  /// stands.
  ///
  /// This column is the one the obligation note above promises. It says the
  /// source is stored "so a reviewer can see which kind of answer a severity
  /// rests on and disagree with the weaker ones" — and until this existed there
  /// was no way to disagree. A clause written in declarative prose ("All
  /// external APIs are exposed through Apigee") parses as `unstated`, which
  /// caps a real breach of it at Check; the reviewer who knows it is mandatory
  /// can now say so, and the severity follows.
  ///
  /// Severity is a function of verdict and obligation, so correcting either
  /// moves the finding up or down the register, the risk matrix and the route
  /// the submission takes. See `effectiveFinding` in src/lib/ingest/verdicts.ts,
  /// which is the only place the engine's answer and the reviewer's are
  /// resolved into the one a reader is shown.
  reviewerObligation String?

  /// The severity a reviewer has put on this finding, overriding the derived
  /// one. "critical" | "moderate" | "check", or null — which is the normal
  /// state and means it is still worked out from the verdict and the obligation.
  ///
  /// Severity is otherwise a pure function of those two, which is right as a
  /// default and wrong as the only way in. A reviewer who thinks "this one is
  /// critical" had to reach it sideways by arguing the obligation was mandatory
  /// — and the obligation is a claim about *what the standard says*, not about
  /// how much this breach matters. Making one carry the other meant a reviewer
  /// adjusting priority had to misstate the standard to do it.
  ///
  /// It does not touch the verdict, and nothing here will let it. The verdict
  /// says what the engine found in the design; this says how much it matters.
  /// A `contradicts` graded Moderate is still a contradiction — the design
  /// still states something the standard forbids — and it must stay one in the
  /// register, the export and every count. Severity is a priority, never a
  /// reclassification, and the two axes stay independent by construction: they
  /// are different columns and `effectiveFinding` reads them separately.
  ///
  /// Only meaningful where the verdict carries a severity at all. On `covered`
  /// or `not_applicable` there is nothing to act on, so the resolver reports no
  /// severity whatever this holds — "Covered · Critical" is a row that reads as
  /// a problem when it is the opposite. The value is kept rather than cleared,
  /// so a reviewer who moves a finding to covered and back finds their own
  /// grading still on it.
  reviewerSeverity String?

  /// The reviewer's own wording of why, where the engine's will not do.
  ///
  /// Null means the engine's `rationale` stands, which is the normal state. The
  /// rationale is not decoration: it is the sentence that reaches the board
  /// packet and the exported report, so a reviewer who can see it is wrong and
  /// cannot fix it is signing off prose they disagree with.
  ///
  /// Beside the engine's rather than over it, for the same reason
  /// `reviewerVerdict` sits beside `verdict`: the disagreement is the evaluation
  /// data, and overwriting the model's answer destroys the only record of how
  /// well it is actually doing.
  reviewerRationale String?

  /// Who last edited this finding, and when. Denormalised beside the id, as
  /// everywhere else a person is recorded here, so the report still attributes
  /// the correction after their account is gone.
  ///
  /// The current position only — every change is appended to `FindingEdit`,
  /// which is what an audit reads. These three are here so the common question
  /// ("has anyone touched this, and who?") costs no join.
  editedAt     DateTime?
  editedById   String?
  editedByName String    @default("")

  createdAt DateTime @default(now())

  /// Every change a person has made to this finding, newest first.
  edits FindingEdit[]

  @@unique([runId, clauseId, designKey])
  @@index([runId, documentId])
  @@index([runId, verdict])
  /// Severity is a function of verdict and obligation, so the report groups on
  /// the pair. Created in 20261014090000_finding_obligation and declared here
  /// only later — an index the database held but the schema did not was one
  /// `prisma migrate` would offer to drop on the next unrelated change.
  @@index([runId, obligation], map: "finding_run_obligation_idx")
  @@map("finding")
}

/// One change a person made to one finding.
///
/// Append-only, and the reason this is a table rather than three more columns
/// on `Finding`. A finding carries its *current* position; this carries how it
/// got there. "Who changed this verdict from covered to contradicts, when, and
/// what did they say about it" is the question a governance audit puts to a
/// compliance tool, and a column that has been overwritten four times cannot
/// answer it.
///
/// It is also the only honest record of disagreement with the engine. An
/// override is evaluation data — it is the single thing that will ever say how
/// well the model is doing — and a reviewer who corrects a verdict, thinks
/// again and corrects it back has produced two data points, not none.
///
/// One row per field changed rather than one per save, so "every verdict
/// corrected in March" is a query rather than a scan through blobs. A save that
/// touches the verdict and the rationale writes two rows sharing a `batch`.
model FindingEdit {
  id String @id @default(cuid())

  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  /// Ties the rows written by one save together, so the history reads as "M.
  /// Dexter corrected the verdict and the obligation" rather than as two
  /// unrelated events a millisecond apart.
  batch String

  /// Which field moved: "verdict" | "obligation" | "rationale" | "note" |
  /// "state". A string rather than an enum, for the reason the rest of this
  /// schema gives: a vocabulary that grows should not cost a migration.
  field String

  /// The values either side of the change, as text. `before` is null where
  /// there was nothing there — the first time a reviewer writes a rationale,
  /// the engine's own wording is what it replaced, and that is recorded rather
  /// than left to be inferred.
  ///
  /// Text rather than Json: every field this records is a short string or a
  /// paragraph, and a column an auditor can read with `select` beats one that
  /// needs unwrapping.
  before String?
  after  String?

  /// Why, in the reviewer's words. Empty where they gave none — the change is
  /// still recorded, because an unexplained correction is a fact an audit wants
  /// and refusing to store it would simply hide it.
  reason String @default("")

  /// Nullable with a denormalised name beside it, as everywhere else a person
  /// is recorded in this schema: the history has to keep naming who did this
  /// after their account is deleted.
  editedById   String?
  editedBy     User?   @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByName String  @default("")

  createdAt DateTime @default(now())

  /// The history panel reads one finding newest-first, which is this index.
  @@index([findingId, createdAt])
  @@index([editedById])
  @@map("finding_edit")
}

/// A ruling the organisation has already made, carried into future assessments.
///
/// The third leg of the product promise. Standards say what good looks like and
/// principles say why; this is what *this* customer decided when the two met a
/// real design — "KMS-managed keys in eu-west-1 satisfy encryption at rest",
/// "we accepted Kafka over Kinesis, stop raising it". Without it every
/// assessment re-litigates settled questions and the reviewer overrides the
/// same finding forever.
///
/// Two ways in: promoted from a reviewed finding (see `promote` in
/// src/lib/ingest/decisions.ts) or authored directly in the register.
model Decision {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// A short handle for the register. The statement is the ruling itself.
  title     String
  statement String
  rationale String @default("")

  /// How this should bias a verdict:
  ///   accepts   the arrangement it describes satisfies the clause
  ///   rejects   the arrangement it describes does not, and is a breach
  ///   context   neither — background the model should weigh
  effect String @default("context")

  /// How far this ruling reaches:
  ///   organisation   every assessment this customer ever runs
  ///   project        only assessments of `projectId`
  ///
  /// A review board routinely allows a breach *for one piece of work* — a
  /// migration that keeps a legacy protocol until it is retired, a pilot
  /// exempted while it is a pilot. Recorded organisation-wide, that exemption
  /// silently becomes policy and every later design inherits it.
  ///
  /// Stored as its own column rather than inferred from `projectId IS NULL`,
  /// because the two disagree in the case that matters: if the project row ever
  /// goes, a project-only exemption with a nulled `projectId` would read as
  /// organisation-wide and start applying everywhere. With the scope recorded,
  /// it matches nothing instead, and the register can say the project is gone.
  scope String @default("organisation")

  /// The project a `project`-scoped ruling applies to. Null when it applies
  /// organisation-wide, which is every decision recorded before scopes existed.
  ///
  /// `SetNull` for the same reason as Document.projectId: a project is
  /// archived, not deleted, and a ruling an audit may ask about must outlive
  /// one if it ever is removed. See the note on `scope` for what the pair means
  /// once that has happened.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// The clause this answers, when it answers one. Not a foreign key, and
  /// denormalised, for the same reason as Finding: reference documents get
  /// re-parsed and re-numbered, and a cascade would erase the review board's
  /// rulings the first time someone re-uploads a standard.
  clauseId    String?
  clauseRef   String  @default("")
  clauseTitle String  @default("")

  /// Where it came from. Null throughout when authored directly.
  sourceFindingId  String?
  sourceRunId      String?
  sourceDocumentId String?

  /// "active" | "superseded" | "expired"
  ///
  /// Decisions are never edited in place. An edit writes a new row and points
  /// the old one at it, so a run from six months ago still means what it said —
  /// the same reasoning that makes Framework versioned rather than mutable.
  status         String    @default("active")
  supersededById String?   @unique
  supersededBy   Decision? @relation("DecisionSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Decision? @relation("DecisionSupersedes")

  /// Architecture exceptions are routinely granted for a fixed term. A register
  /// that cannot expire its own entries turns into policy nobody voted for.
  effectiveFrom DateTime  @default(now())
  expiresAt     DateTime?

  decidedById   String?
  decidedBy     User?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  /// Kept beside the relation so the register still attributes a decision after
  /// the person who made it has left and their row is gone.
  decidedByName String  @default("")

  /// pgvector, written by raw SQL exactly like Embedding.vector — Prisma has no
  /// native type for it. Embedded as a *passage*, because clause queries are
  /// what search it.
  ///
  /// No HNSW index: a register holds hundreds of rows, not millions, and an
  /// exact scan over that is faster than a graph walk. Add one when a customer
  /// crosses ~50k decisions, which would be a different product.
  vector         Unsupported("vector(1024)")?
  embeddingModel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, status])
  @@index([organisationId, clauseRef])
  /// Every clause lookup in a run filters on the scope pair; see
  /// `for_clause` in Workers/aidp/decisions.py.
  @@index([organisationId, scope, projectId])
  @@map("decision")
}

/// What was decided about a submission once its report was read.
///
/// The assessment answers "does this design meet the standard?". This answers
/// "what happens now?", and it is the row a governance audit actually asks for:
/// who accepted this design, when, and on what basis.
///
/// Append-only. An escalation is followed by the board's own decision, and a
/// revised submission gets a new run with its own outcome, so the history is a
/// sequence rather than a field to overwrite. The most recent row for a run is
/// the current position.
model SubmissionOutcome {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  runId String
  run   AssessmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Denormalised so a document's decision history is one query, and so it
  /// still reads correctly if the run is ever re-pointed.
  ///
  /// Null when the run was over a whole project, which is signed off as one
  /// piece of work; `projectId` carries it then. Exactly one of the two is set,
  /// mirroring the run the outcome is about.
  documentId String?

  /// The project signed off, when the run was over all of its designs.
  projectId String?

  // "approved" | "rejected" | "revise" | "escalated"
  //
  // A string rather than an enum so the vocabulary can grow without a
  // migration, which is what adding "rejected" cost. `toView` in
  // src/lib/ingest/outcomes.ts drops a word it no longer recognises rather
  // than coercing it, so an old row can never read as a decision nobody took.
  decision String
  /// Why. Required for rejected, revise and escalated — a refusal its author
  /// cannot answer is a dead end, an instruction with no stated basis is not an
  /// instruction, and a board asked to rule needs the question.
  note     String @default("")

  /// The report as it stood when this was decided: verdict counts, how many
  /// findings were still unreviewed, the total. Captured because findings stay
  /// editable afterwards, and "approved while three contradictions were
  /// outstanding" is exactly what an audit needs to be able to see later.
  snapshot Json @default("{}")

  decidedById   String?
  decidedBy     User?   @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  /// Kept beside the relation so a decision still names its author after the
  /// account is gone.
  decidedByName String  @default("")

  createdAt DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([documentId, createdAt])
  @@index([runId])
  /// A project's decision history, for a run that signed off every design in
  /// it. Created in 20261002094000_project_submission_outcome.
  @@index([projectId, createdAt])
  @@map("submission_outcome")
}

/// Answers we have already paid a provider for.
///
/// Every expensive AI call in this pipeline is a function of its inputs, so the
/// same inputs need only be paid for once. `fingerprint` is a hash of *every*
/// input that can change the output — see Workers/aidp/cache.py, which is the
/// only place keys are built, precisely so that "what does this depend on?" has
/// exactly one answer.
///
/// Getting that key right is the whole design. A key that misses something is
/// not a slow cache, it is a cache that returns a confidently wrong answer, and
/// in a compliance tool that is worse than no cache at all. So the rule is to
/// under-normalise: the fingerprint covers the exact bytes sent to the
/// provider, with no whitespace folding or cleverness. A text that differs by a
/// space misses and costs a fraction of a penny; a false hit costs correctness.
///
/// Scoped per organisation. A cache keyed on customer text is otherwise a
/// channel through which one customer could learn another holds a document
/// containing an exact passage. These are Internal-Use documents held by us as
/// a vendor, and the hit rate lost to tenant isolation is not worth that.
///
/// `kind` is here so the same table takes figure descriptions, chunk preambles
/// and clause verdicts later without a migration. Only embeddings use it today,
/// and only embeddings are risk-free — a verdict depends on the submitted
/// design as well as the standard, and reusing one has to be recorded on the
/// finding or the audit trail starts lying.
/// One company's own model key.
///
/// Per organisation, and generation only — judging clauses, reading a
/// standard's rules, describing a figure, writing a chunk preamble, suggesting
/// improvements. Embeddings are deliberately *not* covered: a vector is only
/// comparable with vectors from the same model, the corpus is indexed by model
/// name, and a company that switched embedding model would silently lose dense
/// retrieval over everything they had already ingested. See the note in
/// src/lib/ingest/retrieval.ts.
///
/// Absent is the normal state. An organisation with no row here is served by
/// the deployment's own key from the environment, which is what every
/// organisation did before this table existed.
///
/// The key itself is never stored in the clear and never leaves the server: the
/// UI is shown `keyLast4` and nothing else, and the Python workers read it
/// through /api/internal/credentials rather than holding a copy — the same
/// arrangement, and the same reasoning, as the UploadThing token in
/// src/lib/ingest/storage.ts.
model ProviderCredential {
  id String @id @default(cuid())

  /// Unique: one live key per company. A second row would mean two answers to
  /// "which model judged this", decided by whichever the query happened to
  /// return first.
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// "openrouter" | "anthropic" | "gemini" — the three clients
  /// Workers/aidp/ai/llm.py implements. Not free text: a provider nothing can
  /// talk to would be accepted here and fail on every job afterwards.
  provider String

  /// AES-256-GCM, base64, with the organisation id as additional authenticated
  /// data — so a ciphertext copied to another company's row fails to decrypt
  /// rather than quietly working. See src/lib/access/secrets.ts.
  ciphertext String

  /// The last four characters, which is all any screen ever shows. Enough to
  /// confirm which key is installed without being enough to use it.
  keyLast4 String

  /// Everything a verdict rests on. Strict JSON replies and vision.
  model     String
  /// The high-volume call — one contextual preamble per chunk.
  fastModel String

  /// OpenRouter only: upstreams a request may be served by. Empty means
  /// OpenRouter's own routing. Pinning is what keeps client documents off a
  /// host the customer has not agreed to.
  openrouterProviders String[] @default([])
  /// OpenRouter only: demand zero-data-retention endpoints. Off by default
  /// because not every model has one.
  zdr                 Boolean  @default(false)

  /// False when the handshake below found the key unable to do the work. The
  /// row is kept rather than discarded so the administrator can see what was
  /// wrong with what they pasted, and the workers skip an inactive key exactly
  /// as if it were absent.
  ///
  /// The probe's verdict, never the administrator's choice — that is `enabled`.
  /// Two fields rather than one because the screen has to tell "your key is
  /// broken" from "you asked for the platform's", and a single flag would make
  /// a deliberately parked key look like a failed one.
  active Boolean @default(true)

  /// The administrator's own switch: off means use the deployment's key, and
  /// keep this one.
  ///
  /// Trying a key and going back used to mean deleting it, so going back again
  /// meant finding and pasting the key a second time. The row survives being
  /// switched off — ciphertext, model, pinned hosts and all — so the two states
  /// are one click apart in both directions.
  ///
  /// To a worker this is indistinguishable from having no key at all, which is
  /// the behaviour every organisation had before any of this existed. See
  /// `resolve` in src/lib/access/credentials.ts.
  enabled Boolean @default(true)

  /// What the key could do when it was last tested: authentication, strict JSON
  /// replies, vision. Stored because a key that authenticates but cannot return
  /// a JSON object breaks assessments one clause at a time — caught by the
  /// per-clause guard, which is to say silently. Far better to find out while
  /// somebody is looking at the screen that saved it.
  probe    Json?
  probedAt DateTime?

  /// Who installed it. Null once that account is deleted; the key is the
  /// company's, not theirs, and must not leave with them.
  setById String?
  setBy   User?   @relation(fields: [setById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provider_credential")
}

model AiCache {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// "embedding" today. "figure" | "preamble" | "verdict" later.
  kind String

  /// sha256 over every input the answer depends on, including the model name —
  /// so the day a provider retires a model, every entry it produced stops
  /// matching instead of being served from under the new one.
  fingerprint String

  /// Denormalised out of the fingerprint for diagnostics: the hash cannot be
  /// read, and "which model produced this row" is the first question asked of a
  /// cache that looks wrong.
  model String

  /// Embeddings live in a pgvector column rather than JSON: 1024 floats are 4KB
  /// here and roughly 20KB as JSON text, and this table grows per distinct
  /// passage per customer.
  vector Unsupported("vector(1024)")?

  /// Everything that is not a vector — a figure description, a verdict object.
  payload Json?

  /// What this answer cost to produce the first time. Kept so the saving is
  /// reportable: hits multiplied by this is the bill that was never sent.
  costTokens Int @default(0)

  /// Reuse count and recency, for reporting and for evicting what nobody wants.
  hits       Int      @default(0)
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([organisationId, kind, fingerprint])
  @@index([organisationId, lastUsedAt])
  @@map("ai_cache")
}

// ---------------------------------------------------------------------------
// Architecturally significant review
//
// The governance wrapper around the assessment engine. A request is one
// submission through the five-step workflow: Intake, an Architecture Criteria
// Check and an Architecture Review running in parallel off the same intake
// data, a combined Review Report, and a Decision.
//
// The workers reach two of these tables and no more. A reading of the attached
// designs (Workers/aidp/request_intake.py) reads `architecture_request` for the
// project its designs sit in, and writes `intake_reading`. That is the whole of
// it, and it is deliberately the harmless half: a reading proposes answers a
// person then accepts, and accepting is what writes the request's own columns.
//
// What the workers still cannot touch is everything that decides anything —
// the significance result, the assignment, the outcome. This layer surrounds
// the engine and the engine cannot reach back into it to change a verdict or an
// answer. The other place the two meet is `documentId` below.
// ---------------------------------------------------------------------------

/// One submission through the ARB workflow.
///
/// This is the governance record, and it outlives everything it produced. A
/// document can be removed from the library and a project archived; the
/// question "what was submitted, and what was decided about it" still has to
/// have an answer, which is why the links out of here are deliberately weak.
model ArchitectureRequest {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The human-readable identifier, "AR-0001". Quoted in email subjects, in a
  /// board packet and by whoever rings up to ask about it, none of which can be
  /// done with a cuid.
  ///
  /// Per organisation, not global: a customer counting their own submissions
  /// from one should not be able to infer how many another has filed.
  reference String

  /// The piece of work this belongs to. Required, and chosen by the requestor
  /// rather than created from the title — see the note on Project.requests.
  ///
  /// `SetNull` is not available here because the column is required; a project
  /// is archived rather than deleted, so the cascade is the honest description
  /// of what removing one would mean for the requests inside it.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The design the engine actually assessed, written once the intake answers
  /// have been rendered into a document and taken in through `record()` in
  /// src/lib/ingest/intake.ts.
  ///
  /// Not a foreign key, for the same reason as Decision.sourceDocumentId: a
  /// governance record has to survive its source document being removed from
  /// the library, and a cascade here would erase the submission along with it.
  ///
  /// Null until the document exists, which is always *after* this row does. The
  /// rendered document carries this request's id and submission time inside it
  /// precisely so that two identical sets of answers do not hash to the same
  /// bytes — `record()` is content-addressed and would otherwise resolve the
  /// second submission to the first one's document and never start a run.
  documentId String?

  /// The diagram, when one was supplied. Relation-free for the same reason.
  ///
  /// One of the designs attached to this request, nominated by the requestor —
  /// nothing infers it. A file being an image does not make it the architecture
  /// diagram, and the brief hangs a mandatory-field rule on this answer, so it
  /// is one a person gives rather than one the platform guesses at. See
  /// `markDiagram` in src/lib/ingest/requests.ts.
  diagramDocumentId String?

  /// The assessment this request opened. Relation-free for the same reason.
  runId String?

  // --- Group A: request basics ---------------------------------------------

  /// Who raised it. Nullable and paired with a denormalised name, exactly as
  /// Decision.decidedByName is: the record has to keep naming the requestor
  /// after their account is gone.
  requestedById   String?
  requestedBy     User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByName String  @default("")
  /// Their team, as they gave it. A label for routing and the audit trail, not
  /// a reference to anything this system models.
  team            String  @default("")

  title   String
  summary String @default("")

  /// When implementation is planned to begin. Read by the Time Impact
  /// criterion, which asks whether that is further out than the organisation's
  /// configured window.
  plannedStart DateTime?

  // --- Group B: solution description ---------------------------------------

  problemStatement String @default("")
  /// The components and how they interact. This is the text the compliance
  /// check actually runs against, so an empty one is a submission with nothing
  /// to assess — enforced at intake rather than here, because a draft is
  /// allowed to be incomplete and a submitted request is not.
  solutionOverview String @default("")

  // --- Group C: structured architecture details ----------------------------

  technologies String[] @default([])

  newTechnologyComponent     Boolean @default(false)
  newTechnologyComponentName String  @default("")

  replacesTechnologyComponent     Boolean @default(false)
  replacedTechnologyComponentName String  @default("")

  integrationPoints String @default("")

  /// How the solution authenticates and authorises.
  ///
  /// The brief maps this to the Security Impact criterion, but the criterion's
  /// own trigger is "any major change in the security domain", which free text
  /// cannot answer deterministically. `securityDomainChange` below is the field
  /// that actually drives it; this one is prose for the review to read.
  authMechanism String @default("")

  dataStores             String  @default("")
  dataClassification     String  @default("")
  newOrDuplicatedStorage Boolean @default(false)

  hostingEnvironment String @default("")

  // --- Group D: business and governance impact -----------------------------

  /// Estimated cost, against the organisation's configured governance
  /// threshold. No currency column: every threshold a customer configures is in
  /// their own currency and comparing across customers is not a question this
  /// product asks. If that ever changes it is a migration, not a default.
  estimatedCost Decimal? @db.Decimal(18, 2)

  newLicenceRequired Boolean @default(false)
  newLicenceVendor   String  @default("")

  linesOfBusiness       String[] @default([])
  newBusinessCapability Boolean  @default(false)

  regulatoryImpact       Boolean @default(false)
  regulatoryImpactDetail String  @default("")

  /// Not in the brief's field list, and required by its own criteria table.
  ///
  /// Security Impact triggers on "a major change in the security domain, e.g.
  /// one that requires a higher-tier Authority-to-Operate or risk assessment".
  /// The only field the brief maps to that category is the authentication
  /// mechanism, which is prose. A significance check that has to be auditable
  /// cannot rest on a model's reading of a sentence, so the requestor is asked
  /// the question the criterion actually puts.
  securityDomainChange       Boolean @default(false)
  securityDomainChangeDetail String  @default("")

  applicationDecommissioned     Boolean @default(false)
  applicationDecommissionedName String  @default("")

  /// "standard" | "business_critical" | "mission_critical".
  ///
  /// A string rather than an enum, as everywhere else in this schema: the
  /// vocabulary belongs to the customer's own application inventory and will
  /// grow without asking us.
  applicationCriticality String @default("standard")

  newApplicationStandard   Boolean @default(false)
  dataGovernanceEscalation Boolean @default(false)

  standardsChangeProposed Boolean @default(false)
  standardsChangeDetail   String  @default("")

  // --- Workflow state ------------------------------------------------------

  /// "draft"     — being filled in. Mandatory fields are not yet enforced.
  /// "submitted" — accepted; the document is rendered and taken in, and the
  ///               assessment starts as soon as it has finished indexing.
  /// "checking"  — the criteria check and the assessment are running.
  /// "reported"  — both are done and the combined report stands.
  /// "decided"   — an outcome has been recorded against it.
  /// "failed"    — it could not be carried further, and `failureReason` says
  ///               why. A request that cannot proceed has to say so: the
  ///               alternative is a submission that sits in "submitted" for
  ///               ever while its requestor waits for a report.
  ///
  /// A string with its values written down here rather than a Prisma enum, for
  /// the reason SubmissionOutcome.decision gives: a vocabulary that grows
  /// should not cost a migration.
  state String @default("draft")

  /// Why it stopped, in words the requestor can act on — their standards
  /// library is empty, or the rendered document could not be read. Null in
  /// every other state, and cleared when a retry gets further.
  failureReason String?

  /// The criteria check's answer: "significant" | "not_significant", or null
  /// while it has not run.
  ///
  /// Stored rather than derived from the results below. Criteria are editable,
  /// and a report has to keep explaining the classification it actually
  /// reached — the same reasoning that pins a framework version to a run.
  significance   String?
  significanceAt DateTime?

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  significanceResults SignificanceResult[]
  assignments         ReviewAssignment[]
  /// What the attached designs were read to say, awaiting the requestor's
  /// confirmation. At most one — see IntakeReading.
  reading             IntakeReading?

  /// One reference per customer. The generator counts this customer's existing
  /// requests, so the constraint is what makes two people filing at the same
  /// moment collide loudly instead of sharing a reference.
  @@unique([organisationId, reference])
  @@index([organisationId, state])
  @@index([projectId])
  @@map("architecture_request")
}

/// One configurable rule for deciding whether a submission is architecturally
/// significant.
///
/// Seeded with the brief's nine categories and editable by an administrator
/// thereafter, which is the whole point of it being a table: the thresholds are
/// the customer's governance policy, not ours.
model SignificanceCriterion {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// Stable machine name — "major_technology_change", "cost_impact". One per
  /// customer, and never rewritten: the seed is matched on it, and a stored
  /// result names it to say which rule was applied.
  category String

  /// What an administrator sees. Editable, which is exactly why a result
  /// denormalises it rather than joining to it.
  label       String
  description String @default("")

  /// The conditions, any one of which triggers this category — the brief lists
  /// them as bullets under each heading, and bullets are an "or".
  ///
  /// Shape, checked by the evaluator rather than by Postgres:
  ///
  ///   [{ "field": "newTechnologyComponent", "operator": "is_true" },
  ///    { "field": "estimatedCost", "operator": "at_least", "value": 5000000 },
  ///    { "field": "plannedStart", "operator": "further_out_than_months", "value": 12 }]
  ///
  /// `field` names a column on ArchitectureRequest. Json rather than columns
  /// because this is a small rule language and a table of operators would be a
  /// schema that changes every time a customer phrases a threshold differently.
  conditions Json @default("[]")

  /// An administrator turns a category off rather than deleting it, so that
  /// results recorded while it was on keep making sense.
  active Boolean @default(true)

  /// Display order. The brief's own ordering, by default.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, category])
  @@index([organisationId, active])
  @@map("significance_criterion")
}

/// What the criteria check found, one row per criterion it looked at.
///
/// Both halves are recorded, not just the triggers: the brief asks for "the
/// specific criteria checked and triggered", and a list of triggers alone
/// cannot answer "was this category even considered?" once an administrator has
/// turned one off.
model SignificanceResult {
  id String @id @default(cuid())

  requestId String
  request   ArchitectureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Not a foreign key, and the wording below is denormalised beside it, for
  /// the same reason Finding carries `clauseRef` and `clauseStatement`:
  /// criteria are editable, and a classification reached in March has to keep
  /// stating the rule it was reached under.
  criterionId   String
  category      String
  categoryLabel String
  conditionText String @default("")

  triggered Boolean @default(false)

  /// Which answers fired it: [{ field, operator, value, actual }]. Empty when
  /// nothing did. This is the line an auditor reads — "cost impact triggered
  /// because 7,500,000 is at least 5,000,000" — and it is why the check stores
  /// its working rather than only its conclusion.
  triggeredBy Json @default("[]")

  createdAt DateTime @default(now())

  @@unique([requestId, criterionId])
  @@index([requestId, triggered])
  @@map("significance_result")
}

/// Which architect a request is routed to.
///
/// A row per routing rather than a column on the request, because reassignment
/// is normal — somebody is on leave, somebody else owns that domain — and
/// "who was it with on the 12th" is a question a governance audit asks. The
/// live one is the row whose state is "active".
model ReviewAssignment {
  id String @id @default(cuid())

  requestId String
  request   ArchitectureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// The architect. Nullable with a denormalised name beside it, as everywhere
  /// else a person is recorded here.
  assignedToId   String?
  assignedTo     User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToName String  @default("")

  /// Who routed it, or empty when the platform did it from the decision logic.
  assignedById   String?
  assignedByName String  @default("")

  /// "active" | "completed" | "reassigned"
  state String @default("active")

  /// Why it was routed here, when somebody chose rather than the rules.
  note String @default("")

  createdAt DateTime @default(now())

  @@index([requestId, state])
  @@index([assignedToId, state])
  @@map("review_assignment")
}

/// What the attached designs say the structured answers are.
///
/// The brief's Group C is "mandatory if no diagram; otherwise auto-extracted
/// from the diagram and shown for confirmation". The second half of that
/// sentence is this table. A requestor who has attached a design has already
/// said everything Group C asks for — in prose, in a diagram, in a table — and
/// asking them to transcribe it into twenty boxes is the data-entry problem the
/// product exists to remove.
///
/// ## Why it is a proposal and never an answer
///
/// Nothing here is ever read by the significance check, the renderer or the
/// report. A reading proposes; a person accepts; accepting writes the ordinary
/// column on `ArchitectureRequest`, and from that moment the answer is
/// indistinguishable from a typed one. That is deliberate and it is the whole
/// safety argument: a classification that decides whether a human reviews a
/// submission must rest on what a person stated, not on what a model inferred
/// while nobody was looking.
///
/// So this holds inferences, and the request holds answers. `acceptedFields`
/// records which of the request's answers arrived this way, because "the
/// requestor typed Confidential" and "the requestor agreed the design said
/// Confidential" are different claims at a review board.
///
/// One per request. A second reading replaces the first rather than
/// accumulating: the designs have changed, so the earlier inference is about a
/// submission that no longer exists.
model IntakeReading {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  requestId String              @unique
  request   ArchitectureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// "reading" | "ready" | "failed"
  ///
  /// "reading" is a job on the queue. The wizard polls on it, exactly as the
  /// document library polls a parse.
  state String @default("reading")

  /// The proposals, as the worker checked them. One entry per Group C field it
  /// could answer, each carrying the design's own words:
  ///
  ///   [{ field, value, documentId, documentTitle, section, page, quote }]
  ///
  /// A field the designs do not answer is absent rather than present-and-empty.
  /// "The design does not say" is a real answer and the requestor has to give
  /// it themselves; a blank proposed as though it were read would be the
  /// inference nobody made.
  proposals Json @default("[]")

  /// Which fields the requestor accepted. Named rather than counted, so the
  /// report can say which answers came from the design.
  acceptedFields String[] @default([])

  /// The designs this reading was made from, as titles. A reading is only
  /// honest about the submission it read, and a design added afterwards is not
  /// in it.
  readDocumentIds String[] @default([])

  /// Which model, for the audit trail, and what went wrong when nothing came.
  model String?
  error String?

  requestedById   String?
  requestedByName String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId, state])
  @@map("intake_reading")
}

// ---------------------------------------------------------------------------
// Notifications
//
// The outbox. Everything the platform has to tell somebody about — a
// submission received, a report ready, a decision recorded — is a row here
// before it is a message anywhere.
//
// Written in the same breath as the thing it is about, so a state change and
// the news of it either both happen or neither does, and drained separately by
// src/lib/notifications/drain.ts. Nothing sends mail inline: a provider that is
// slow makes a person wait, a provider that is down loses the message with no
// record that it was ever owed, and neither failure is visible afterwards.
//
// This table is also the audit record the brief asks for. Resend keeps its own
// logs for days and the retention requirement is measured in years, so what was
// sent, to whom, and what the provider said about it has to live here.
// ---------------------------------------------------------------------------

/// One message owed to one recipient.
///
/// The row is created queued and ends `sent`, `skipped` or `dead`. It is never
/// deleted on success — a sent notification is evidence that somebody was told,
/// which is exactly the question an audit asks.
model Notification {
  id String @id @default(cuid())

  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  /// The request this is about, when it is about one. Null for the messages
  /// that belong to an account rather than a submission.
  ///
  /// Relation-free, for the reason ArchitectureRequest.documentId is: this row
  /// records that a person was told something, and that stays true after the
  /// thing they were told about has been removed. A cascade here would delete
  /// the evidence along with the subject.
  requestId String?

  /// What kind of message this is. The catalogue is
  /// src/lib/notifications/kinds.ts, which owns the rendering for each one.
  ///
  /// A string rather than an enum so the vocabulary can grow without a
  /// migration, the same choice SubmissionOutcome.decision made. A row whose
  /// kind is no longer recognised dead-letters rather than being guessed at.
  kind String

  /// What makes this message the only one of its kind.
  ///
  /// `requestId:kind:channel:recipient`. The unique index on it is the whole
  /// defence against duplicates, and it is not a theoretical one: the screens
  /// sweep their own state on every render (see advanceSubmitted in
  /// src/lib/ingest/requests.ts), so the question "has this request moved on?"
  /// is asked constantly and every answer re-runs the code that enqueues. The
  /// insert is ON CONFLICT DO NOTHING against this column, which is what turns
  /// a hundred enqueues into one email.
  ///
  /// Channel is in the key because the same news on two channels is two
  /// messages, and leaving it out would mean a portal notification silently
  /// suppressing the email that should have gone with it.
  dedupeKey String @unique

  /// "email" | "portal"
  channel String @default("email")

  /// Snapshotted at enqueue, not resolved at send.
  ///
  /// The address is what it was when the news happened. Looking it up at send
  /// time would mean a message addressed by a lookup that can now return
  /// nothing — recipients are `onDelete: SetNull` throughout this schema — and
  /// an audit record that cannot say where it actually went.
  toEmail  String?
  toUserId String?
  toName   String  @default("")

  /// Everything the template needs, captured when the news happened.
  ///
  /// A snapshot rather than foreign keys, the same reasoning
  /// SubmissionOutcome.snapshot applies: a message has to render a year later
  /// the way it would have rendered on the day, even though the request has
  /// moved several states since.
  payload Json @default("{}")

  /// "queued" | "leased" | "sent" | "skipped" | "dead"
  ///
  /// `skipped` is a first-class outcome and not a failure: a recipient with no
  /// address is a message that was correctly not sent, and recording it as an
  /// error would bury the real ones.
  state String @default("queued")

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  /// Backoff target. A retry is invisible to drainers until now() passes this.
  runAfter   DateTime  @default(now())
  leaseUntil DateTime?
  leaseOwner String?

  /// The provider's own id for the message — Resend's, today. The handle that
  /// makes a delivery question answerable months later.
  providerId String?
  lastError  String?

  /// Follows the message, and matches the correlation id of the work that
  /// caused it where there is one. Same requirement as Job.correlationId.
  correlationId String

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// The claim path: drainers only ever look at queued rows that are due.
  @@index([state, runAfter])
  /// Everything sent about one submission, newest first.
  @@index([requestId, createdAt])
  /// The operator's view of one customer's mail.
  @@index([organisationId, createdAt])
  @@map("notification")
}
